{
	"name": "dddsw-web",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"package": "svelte-kit package",
		"preview": "vite preview",
		"test": "playwright test --project=local",
		"test:ui": "playwright test --ui --project=local",
		"test:update-screenshots": "playwright test tests/visual-comparison.spec.ts --update-snapshots --project=local",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . & eslint .",
		"lint:fix:all": "eslint --fix . & prettier --write .",
		"lint:fix:staged": "npx lint-staged",
		"prepare": "husky && svelte-kit sync",
		"test:unit": "vitest run"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@fortawesome/free-brands-svg-icons": "7.3.1",
		"@fortawesome/free-solid-svg-icons": "7.3.1",
		"@playwright/test": "1.64.1",
		"@skeletonlabs/skeleton": "5.0.1",
		"@skeletonlabs/skeleton-svelte": "5.0.1",
		"@sveltejs/adapter-cloudflare": "8.0.1",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"wrangler": "4.154.0"
	},
	"type": "module",
	"dependencies": {
		"@fontsource-variable/fredoka": "5.3.0",
		"@fontsource-variable/nunito": "5.3.0",
		"@panzoom/panzoom": "^4.6.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
